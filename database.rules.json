{
  "rules": {
    ".read": false,
    ".write": false,
    "tournaments": {
      ".read": true,
      ".indexOn": [
        "createdAt",
        "clubName"
      ],
      "$tournament_id": {
        ".write": "!data.exists() || data.child('status').val() !== 'completed'",
        ".validate": "newData.hasChildren(['id', 'name'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "clubName": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        }
      }
    },
    "club_members": {
      ".read": true,
      "$club_key": {
        ".write": "newData.exists() || !data.child('1').exists()",
        "$index": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        }
      }
    },
    "club_passwords": {
      ".read": false,
      ".write": false
    },
    "club_mappings": {
      ".read": false,
      ".write": false
    },
    "clubs_metadata": {
      ".read": true,
      "$club_key": {
        ".write": "!root.child('club_passwords').child($club_key).exists()",
        "isPrivate": {
          ".validate": "newData.isBoolean()"
        },
        "hasPassword": {
          ".validate": "newData.isBoolean() && newData.val() === root.child('club_passwords').child($club_key).exists()"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "code": {
          ".write": "!data.exists() && root.child('club_codes').child(newData.val()).val() === $club_key",
          ".validate": "newData.isString() && newData.val().matches(/^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{5}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "users": {
      "$user_id": {
        ".read": true,
        ".write": true,
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "pictureUrl": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "lastLoginAt": {
          ".validate": "newData.isNumber()"
        },
        "lastClub": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "myClubs": {
          "$club": {
            ".validate": "newData.isBoolean() && $club.length <= 200"
          }
        },
        "following": {
          "$tournament_id": {
            ".validate": "newData.isNumber()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "app_config": {
      "master_pin_hash": {
        ".read": false,
        ".write": false
      },
      "line_bot": {
        ".read": false,
        ".write": false
      }
    },
    "club_codes": {
      ".read": true,
      "$code": {
        ".write": "!data.exists() || (newData.exists() && root.child('clubs_metadata').child(newData.val()).child('code').val() === $code)",
        ".validate": "newData.isString() && newData.val().length <= 300 && $code.matches(/^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{5}$/)"
      }
    }
  }
}
