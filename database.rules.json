{
  "rules": {
    ".read": false,
    ".write": false,
    "tournaments": {
      ".read": true,
      ".indexOn": [
        "createdAt",
        "clubName"
      ],
      "$tournament_id": {
        ".write": "!data.exists() || data.child('status').val() !== 'completed'",
        ".validate": "newData.hasChildren(['id', 'name'])",
        "clubName": {
          ".write": true
        }
      }
    },
    "club_members": {
      ".read": true,
      "$club_key": {
        ".write": true
      }
    },
    "club_passwords": {
      ".read": false,
      ".write": false
    },
    "club_mappings": {
      ".read": true,
      "$club_key": {
        ".write": true
      }
    },
    "clubs_metadata": {
      ".read": true,
      "$club_key": {
        ".write": true
      }
    },
    "users": {
      "$user_id": {
        ".read": true,
        ".write": true
      }
    },
    "app_config": {
      "master_pin_hash": {
        ".read": false,
        ".write": false
      },
      "line_bot": {
        ".read": false,
        ".write": false
      }
    },
    "club_codes": {
      ".read": true,
      "$code": {
        ".write": "!data.exists() || (newData.exists() && root.child('clubs_metadata').child(newData.val()).child('code').val() === $code)",
        ".validate": "newData.isString() && newData.val().length <= 300 && $code.matches(/^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{5}$/)"
      }
    }
  }
}
